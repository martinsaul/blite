# Builds the blite client against Ubuntu 24.04's GStreamer (1.24), so the binary
# runs on Ubuntu 24.04 and derivatives (Linux Mint 22, Pop!_OS 24.04).
#   docker build -f Dockerfile.client-ubuntu2404 --output type=local,dest=out .
# Base image and Go pinned by digest and hash (reproducible builds).
FROM ubuntu:24.04@sha256:562111b88caa79c71391c0c4d3c2114a7d5c35915c20561fd893cb1e07929e6b AS build
ARG GO_VERSION=1.26.10
ARG GO_SHA256=ccfe7ae822d2c2f41f4fe7c956199967a4dac22d0ee0d2b2bfdb440aab3b20c5
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl gcc pkg-config \
      libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev libgstreamer-plugins-bad1.0-dev \
      libgl1-mesa-dev libx11-dev libxcursor-dev libxrandr-dev libxinerama-dev libxi-dev libxxf86vm-dev \
      libwayland-dev libxkbcommon-dev \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSLo /tmp/go.tgz https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz \
    && echo "${GO_SHA256}  /tmp/go.tgz" | sha256sum -c - \
    && tar -C /usr/local -xzf /tmp/go.tgz && rm /tmp/go.tgz
ENV PATH=/usr/local/go/bin:$PATH CGO_ENABLED=1 GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
COPY third_party ./third_party
RUN go mod download
COPY . .
ARG LDFLAGS="-s -w"
RUN go build -trimpath -buildvcs=false -ldflags="${LDFLAGS}" -o /out/blite ./cmd/blite

FROM scratch
COPY --from=build /out/blite /blite
