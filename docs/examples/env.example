# Copy to .env. Everything is optional; with nothing set peers get public
# STUN only, and peers behind symmetric NAT can't connect.

# Behind a reverse proxy that sets X-Forwarded-For (or CF-Connecting-IP):
# BLITE_TRUST_PROXY=true

# TURN via coturn's use-auth-secret (static-auth-secret in turnserver.conf):
# BLITE_TURN_SECRET=change-me
# BLITE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp

# Or a fixed ICE server list instead:
# BLITE_ICE_JSON=[{"urls":["stun:stun.l.google.com:19302"]}]

# Hosted relay: a shared secret between the signal server and the relay,
# e.g. from `openssl rand -hex 32`.
# BLITE_HOST_KEY=

# Client build gates (build numbers): refuse older clients / nudge them.
# BLITE_MIN_COMPATIBLE_BUILD=0
# BLITE_MIN_RECOMMENDED_BUILD=0
